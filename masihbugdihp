    let activeLevelIndex = 0;
    let activeChapterIndex = 0;
    let isHeroMode = false;
    let isReadingMode = false;

    const cardsTrack = document.getElementById('cardsTrack');
    const pagerRow = document.getElementById('pagerRow');
    const dotsIndicator = document.getElementById('dotsIndicator');
    const mainStage = document.getElementById('mainStage');
    const bottomHud = document.getElementById('bottomHud');
    const bgContainer = document.getElementById('bgContainer');
    const btnCloseOverlay = document.getElementById('btnCloseOverlay');
    const btnCloseText = document.getElementById('btnCloseText');
    const readingOverlay = document.getElementById('readingOverlay');

    function initApp() {
      renderCards();
      renderPager();
      updateStageUI(0);
    }

    function renderCards() {
      cardsTrack.innerHTML = levelsData.map((lvl, idx) => `
        <div class="course-card ${idx === activeLevelIndex ? 'active-card' : ''}" 
             style="--card-img: ${lvl.cardImg}"
             onclick="handleCardClick(${idx})">
          <div class="card-top">
            <div class="card-badge-orb">${idx + 1}</div>
            <span class="card-chapter-count">${lvl.chapters.length} BAB UTAMA</span>
          </div>
          <div class="card-bottom">
            <div class="card-level-tag">${lvl.code}</div>
            <div class="card-title">${lvl.cardTitle.replace('\n', '<br>')}</div>
            <div class="card-subtitle">
              <span>${lvl.cardSub}</span>
              <span>→</span>
            </div>
          </div>
        </div>
      `).join('');
    }

    function renderPager() {
      pagerRow.innerHTML = levelsData.map((_, idx) => `
        <button class="pager-num ${idx === activeLevelIndex ? 'active' : ''}" 
                onclick="selectLevel(${idx})">${idx + 1}</button>
      `).join('');

      dotsIndicator.innerHTML = levelsData.map((_, idx) => `
        <div class="dot ${idx === activeLevelIndex ? 'active' : ''}"></div>
      `).join('');
    }

    function selectLevel(index) {
      activeLevelIndex = index;
      activeChapterIndex = 0;
      updateStageUI(index);
    }

    function handleCardClick(index) {
      if (activeLevelIndex !== index) {
        selectLevel(index);
      }
      enterHeroMode();
    }

    function enterHeroMode() {
      isHeroMode = true;
      mainStage.classList.add('hero-active');
      bgContainer.classList.add('hero-mode');
      btnCloseOverlay.style.display = 'flex';
      btnCloseText.textContent = 'SEMUA BAGIAN';
      updatePeekCard();
    }

    function exitHeroMode() {
      isHeroMode = false;
      mainStage.classList.remove('hero-active');
      bgContainer.classList.remove('hero-mode');
      btnCloseOverlay.style.display = 'none';
    }

    function handleTopClose() {
      if (isReadingMode) {
        closeReadingView();
      } else if (isHeroMode) {
        exitHeroMode();
      }
    }

    function returnToMainStage() {
      if (isReadingMode) closeReadingView();
      if (isHeroMode) exitHeroMode();
    }

    function nextLevelInHero() {
      const nextIdx = (activeLevelIndex + 1) % levelsData.length;
      selectLevel(nextIdx);
      updatePeekCard();
    }

    function updatePeekCard() {
      const nextIdx = (activeLevelIndex + 1) % levelsData.length;
      const nextLvl = levelsData[nextIdx];
      document.getElementById('peekOrb').textContent = nextIdx + 1;
      document.getElementById('peekTag').textContent = nextLvl.code;
      document.getElementById('peekTitle').innerHTML = nextLvl.cardTitle.replace('\n', '<br>');
      document.getElementById('peekSub').textContent = nextLvl.cardSub;
    }

    function updateStageUI(index) {
      const lvl = levelsData[index];
      const shiftAmount = index * -180;
      cardsTrack.style.transform = `translateX(${shiftAmount}px)`;

      document.querySelectorAll('.course-card').forEach((el, i) => {
        el.classList.toggle('active-card', i === index);
      });
      document.querySelectorAll('.pager-num').forEach((el, i) => {
        el.classList.toggle('active', i === index);
      });
      document.querySelectorAll('.dot').forEach((el, i) => {
        el.classList.toggle('active', i === index);
      });

      document.querySelectorAll('.bg-layer').forEach((bg, i) => {
        bg.classList.toggle('active', i === index);
      });

      document.getElementById('topRegionLabel').textContent = lvl.regionHeader;
      document.getElementById('topMainTitle').textContent = lvl.code;

      document.getElementById('heroArabic').textContent = lvl.arabicTag;
      document.getElementById('heroHeadline').innerHTML = lvl.heroHeadline;
      document.getElementById('heroDesc').textContent = lvl.heroDesc;

      document.getElementById('metric1Val').innerHTML = `${lvl.metric1Val}<sup>${lvl.metric1Unit}</sup>`;
      document.getElementById('metric1Label').textContent = lvl.metric1Label;
      document.getElementById('metric1Sub').textContent = lvl.metric1Sub;

      document.getElementById('metric2Val').innerHTML = `${lvl.metric2Val}<sup>${lvl.metric2Unit}</sup>`;
      document.getElementById('metric2Label').textContent = lvl.metric2Label;
      document.getElementById('metric2Sub').textContent = lvl.metric2Sub;

      const mapPath = document.getElementById('svgMapPath');
      const curvePath = document.getElementById('svgCurvePath');
      mapPath.setAttribute('d', lvl.svgMap);
      curvePath.setAttribute('d', lvl.svgCurve);

      mapPath.style.animation = 'none';
      curvePath.style.animation = 'none';
      void mapPath.offsetWidth;
      mapPath.style.animation = 'drawLine 1.2s ease forwards';
      curvePath.style.animation = 'drawLine 1.2s ease forwards';

      document.getElementById('coordText').textContent = lvl.coords;
      document.getElementById('coordPlace').textContent = lvl.coordPlace;
      document.getElementById('coordRole').textContent = lvl.coordRole;
      document.getElementById('hudGlobeImg').style.backgroundImage = lvl.cardImg;
    }

    // ================= EDITORIAL READING VIEW LOGIC =================
    function openReadingView() {
      isReadingMode = true;
      bgContainer.classList.add('reading-mode');
      mainStage.classList.add('hidden-for-reading');
      bottomHud.classList.add('hidden-for-reading');
      readingOverlay.classList.add('open');
      btnCloseOverlay.style.display = 'flex';
      btnCloseText.textContent = 'TUTUP RUANG BACA';

      renderChapterPills();
      renderEditorialChapter(activeChapterIndex);
    }

    function closeReadingView() {
      isReadingMode = false;
      bgContainer.classList.remove('reading-mode');
      mainStage.classList.remove('hidden-for-reading');
      bottomHud.classList.remove('hidden-for-reading');
      readingOverlay.classList.remove('open');

      if (isHeroMode) {
        btnCloseOverlay.style.display = 'flex';
        btnCloseText.textContent = 'SEMUA BAGIAN';
      } else {
        btnCloseOverlay.style.display = 'none';
      }
    }

    function renderChapterPills() {
      const lvl = levelsData[activeLevelIndex];
      const bar = document.getElementById('chapterPillBar');
      bar.innerHTML = lvl.chapters.map((ch, idx) => `
        <button class="chapter-pill-btn ${idx === activeChapterIndex ? 'active' : ''}" 
                onclick="switchChapter(${idx})">
          ${ch.pillName}
        </button>
      `).join('');
    }

    function switchChapter(idx) {
      activeChapterIndex = idx;
      renderChapterPills();
      renderEditorialChapter(idx);
    }

    function renderEditorialChapter(idx) {
      const lvl = levelsData[activeLevelIndex];
      const ch = lvl.chapters[idx];
      const storageKey = `maqdisi_timeless_note_${activeLevelIndex}_${idx}`;
      const savedNote = localStorage.getItem(storageKey) || '';

      const hasPrev = idx > 0;
      const hasNext = idx < lvl.chapters.length - 1;

      const container = document.getElementById('editorialContainer');
      container.innerHTML = `
        <header class="chapter-hero">
          <span class="chapter-kicker">${lvl.code} — ${ch.kicker}</span>
          <h1 class="chapter-main-title">${ch.title}</h1>
          <div class="chapter-arabic-banner">
            <div class="chapter-arabic-text">${ch.arabic}</div>
            <div class="chapter-quote-meaning">${ch.quoteMeaning}</div>
          </div>
        </header>

        ${ch.sections.map(sec => `
          <section class="editorial-section">
            <div class="section-index-row">
              <span class="section-num">BAGIAN ${sec.num}</span>
              <div class="section-line"></div>
            </div>
            <h2 class="section-title">${sec.heading}</h2>
            <div class="editorial-prose">
              ${sec.body}
            </div>
          </section>
        `).join('')}

        <!-- UJI PEMAHAMAN & REFLEKSI AL-MAQDISI -->
        <section class="reflection-sanctuary">
          <span class="sanctuary-kicker">INTERNALISASI MA'RIFAH</span>
          <h3 class="sanctuary-title">Uji Ketajaman Konsep</h3>
          <p style="font-size: 1rem; line-height: 1.7; color: var(--text-body);">${ch.quiz.q}</p>
          
          <div class="quiz-minimal-options">
            ${ch.quiz.options.map((opt, oIdx) => `
              <button class="quiz-min-btn" onclick="verifyAnswer(this, ${oIdx}, ${ch.quiz.answer})">
                <strong style="color: var(--gold); margin-right: 0.6rem;">${String.fromCharCode(65 + oIdx)}.</strong> ${opt}
              </button>
            `).join('')}
          </div>
          <div id="quizStatusMsg" style="margin-top: -1.8rem; margin-bottom: 2.5rem; font-size: 0.9rem; font-weight: 600;"></div>

          <span class="sanctuary-kicker">SYARAT GELAR AL-MAQDISI</span>
          <h3 class="sanctuary-title">Catatan Refleksi & Rencana Aksi</h3>
          <p style="font-size: 0.95rem; line-height: 1.7; color: var(--text-muted);">
            Ikatlah ilmu dengan tulisan. Rumuskan intisari pemahamanmu dari bab ini serta langkah konkret yang dapat kamu terapkan untuk menghidupkan budaya Baitul Maqdis:
          </p>
          <textarea class="journal-input" id="journalTextarea" placeholder="Tuliskan refleksi mendalam dan gagasan strategismu di sini...">${savedNote}</textarea>
          <div style="display: flex; align-items: center; gap: 1.2rem; margin-top: 1.1rem;">
            <button class="btn-primary-gold" style="padding: 0.75rem 1.8rem; font-size: 0.74rem;" onclick="saveJournal('${storageKey}')">
              Simpan Catatan Refleksi
            </button>
            <span id="journalSavedBadge" style="font-size: 0.82rem; color: var(--gold);"></span>
          </div>
        </section>

        <footer class="chapter-footer-nav">
          <div>
            ${hasPrev ? `<button class="btn-secondary-glass" onclick="switchChapter(${idx - 1})">← Bab Sebelumnya</button>` : ''}
          </div>
          <div>
            ${hasNext 
              ? `<button class="btn-primary-gold" onclick="switchChapter(${idx + 1})"><span>Bab Selanjutnya</span><span>→</span></button>` 
              : `<button class="btn-secondary-glass" onclick="closeReadingView()">Kembali ke Peta Utama</button>`}
          </div>
        </footer>
      `;

      readingOverlay.scrollTop = 0;
    }

    function verifyAnswer(btnEl, chosenIdx, correctIdx) {
      const parent = btnEl.parentElement;
      const msg = document.getElementById('quizStatusMsg');
      parent.querySelectorAll('.quiz-min-btn').forEach(b => b.classList.remove('correct', 'wrong'));

      if (chosenIdx === correctIdx) {
        btnEl.classList.add('correct');
        msg.style.color = '#34d399';
        msg.textContent = '✓ Tepat sekali. Pemahaman yang akurat adalah pijakan awal menuju Al-Idrak (Ma’rifah).';
      } else {
        btnEl.classList.add('wrong');
        msg.style.color = '#f87171';
        msg.textContent = '✕ Belum tepat. Silakan telaah kembali uraian naratif di atas.';
      }
    }

    function saveJournal(key) {
      const val = document.getElementById('journalTextarea').value;
      localStorage.setItem(key, val);
      const badge = document.getElementById('journalSavedBadge');
      badge.textContent = '✓ Tersimpan otomatis di browser ini';
      setTimeout(() => { badge.textContent = ''; }, 3000);
    }

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      if (isReadingMode) {
        if (e.key === 'Escape') closeReadingView();
        return;
      }
      if (e.key === 'ArrowRight') {
        selectLevel((activeLevelIndex + 1) % levelsData.length);
        if (isHeroMode) updatePeekCard();
      } else if (e.key === 'ArrowLeft') {
        selectLevel((activeLevelIndex - 1 + levelsData.length) % levelsData.length);
        if (isHeroMode) updatePeekCard();
      } else if (e.key === 'Escape' && isHeroMode) {
        exitHeroMode();
      }
    });

    initApp();
  </script>
</body>
