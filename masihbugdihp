<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Baitul Maqdis — Eksplorasi Keilmuan & Strategi</title>
  <!-- Google Fonts: Oswald (Display), Plus Jakarta Sans (Body), Amiri (Arabic/Serif) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Oswald:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --gold: #f5c542;
      --gold-soft: rgba(245, 197, 66, 0.75);
      --gold-glow: rgba(245, 197, 66, 0.3);
      --text-light: #f8fafc;
      --text-body: rgba(248, 250, 252, 0.86);
      --text-muted: rgba(248, 250, 252, 0.55);
      --glass-bg: rgba(12, 18, 32, 0.42);
      --glass-border: rgba(255, 255, 255, 0.16);
      --transition-slow: 0.85s cubic-bezier(0.22, 1, 0.36, 1);
      --transition-fast: 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body, html {
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #050811;
      color: var(--text-light);
      -webkit-font-smoothing: antialiased;
    }

    /* ================= BACKGROUND LAYER ================= */
    .bg-container {
      position: fixed;
      inset: 0;
      z-index: 1;
      overflow: hidden;
    }

    .bg-layer {
      position: absolute;
      inset: -4%;
      background-size: cover;
      background-position: center;
      transition: opacity 1.1s ease, transform 1.6s cubic-bezier(0.22, 1, 0.36, 1), filter 1.1s ease;
      opacity: 0;
      transform: scale(1.08);
    }

    .bg-layer.active {
      opacity: 1;
      transform: scale(1);
    }

    .bg-container.hero-mode .bg-layer.active {
      transform: scale(1.04);
      filter: brightness(0.82) contrast(1.08);
    }

    .bg-container.reading-mode .bg-layer.active {
      transform: scale(1.06);
      filter: brightness(0.28) contrast(1.12) blur(10px);
    }

    .bg-overlay {
      position: absolute;
      inset: 0;
      background: 
        radial-gradient(circle at 50% 42%, rgba(10, 15, 30, 0.18) 0%, rgba(4, 7, 15, 0.78) 100%),
        linear-gradient(180deg, rgba(5, 8, 17, 0.65) 0%, rgba(5, 8, 17, 0.12) 45%, rgba(5, 8, 17, 0.92) 100%);
      z-index: 2;
      pointer-events: none;
    }

    /* ================= TOP HEADER ================= */
    .top-bar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      padding: 2.2rem 4rem;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      z-index: 60;
      pointer-events: none;
      transition: padding var(--transition-fast);
    }

    .brand-cluster {
      display: flex;
      align-items: center;
      gap: 1rem;
      pointer-events: auto;
      cursor: pointer;
    }

    .brand-bar {
      width: 3px;
      height: 38px;
      background: var(--gold);
      box-shadow: 0 0 12px var(--gold);
    }

    .brand-text-wrap {
      display: flex;
      flex-direction: column;
    }

    .brand-sub {
      font-size: 0.66rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 600;
    }

    .brand-title {
      font-family: 'Oswald', sans-serif;
      font-size: 1.3rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      font-weight: 600;
      color: #fff;
      line-height: 1.15;
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
      pointer-events: auto;
    }

    .dua-pill {
      background: rgba(12, 18, 32, 0.5);
      backdrop-filter: blur(12px);
      border: 1px solid var(--glass-border);
      padding: 0.45rem 1.2rem;
      border-radius: 999px;
      font-family: 'Amiri', serif;
      font-size: 0.98rem;
      color: #fde68a;
      letter-spacing: 0.02em;
    }

    .btn-icon-top {
      height: 40px;
      padding: 0 1.2rem;
      border-radius: 999px;
      background: rgba(12, 18, 32, 0.55);
      backdrop-filter: blur(12px);
      border: 1px solid var(--glass-border);
      color: #fff;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      transition: all var(--transition-fast);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .btn-icon-top:hover {
      background: var(--gold);
      color: #050811;
      border-color: var(--gold);
    }

    /* ================= CENTER STAGE (CAROUSEL & HERO) ================= */
    .stage {
      position: relative;
      z-index: 10;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.6s ease, transform 0.6s ease;
    }

    .stage.hidden-for-reading {
      opacity: 0;
      pointer-events: none;
      transform: scale(0.96);
    }

    /* --- CAROUSEL TRACK --- */
    .carousel-viewport {
      width: 100%;
      padding-left: 10vw;
      overflow: visible;
      transition: transform var(--transition-slow), opacity var(--transition-slow);
    }

    .stage.hero-active .carousel-viewport {
      transform: translateX(48vw) scale(0.92);
      opacity: 0;
      pointer-events: none;
    }

    .cards-track {
      display: flex;
      gap: 2.2rem;
      transition: transform var(--transition-slow);
      will-change: transform;
    }

    .course-card {
      position: relative;
      width: 295px;
      height: 400px;
      flex-shrink: 0;
      border-radius: 3px;
      overflow: hidden;
      cursor: pointer;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: var(--glass-bg);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      transition: transform var(--transition-slow), box-shadow var(--transition-slow), border-color var(--transition-fast);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 1.8rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
      user-select: none;
    }

    .course-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: var(--card-img);
      background-size: cover;
      background-position: center;
      opacity: 0.5;
      transition: transform 0.9s ease, opacity 0.6s ease;
      z-index: 0;
    }

    .course-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(8, 12, 24, 0.15) 0%, rgba(8, 12, 24, 0.68) 62%, rgba(8, 12, 24, 0.95) 100%);
      z-index: 1;
    }

    .course-card:hover {
      transform: translateY(-10px);
      border-color: rgba(245, 197, 66, 0.65);
      box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.85), 0 0 25px var(--gold-glow);
    }

    .course-card:hover::before {
      transform: scale(1.08);
      opacity: 0.7;
    }

    .course-card.active-card {
      border-color: var(--gold);
    }

    .card-top, .card-bottom {
      position: relative;
      z-index: 2;
    }

    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .card-badge-orb {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: conic-gradient(from 120deg, var(--gold), #d97706, #0f172a, var(--gold));
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.75rem;
      color: #050811;
      box-shadow: 0 0 12px rgba(245, 197, 66, 0.45);
    }

    .card-chapter-count {
      font-size: 0.68rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.7);
    }

    .card-level-tag {
      font-size: 0.68rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 0.4rem;
      font-weight: 600;
    }

    .card-title {
      font-family: 'Oswald', sans-serif;
      font-size: 2.2rem;
      line-height: 1.02;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #fff;
      margin-bottom: 0.7rem;
      text-shadow: 0 4px 16px rgba(0, 0, 0, 0.65);
    }

    .card-subtitle {
      font-size: 0.72rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.72);
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      padding-top: 0.7rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    /* --- HERO CENTER OVERLAY --- */
    .hero-center {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0 2rem;
      pointer-events: none;
      opacity: 0;
      transform: scale(0.94) translateY(15px);
      transition: opacity var(--transition-slow), transform var(--transition-slow);
    }

    .stage.hero-active .hero-center {
      opacity: 1;
      transform: scale(1) translateY(-18px);
      pointer-events: auto;
    }

    .hero-arabic {
      font-family: 'Amiri', serif;
      font-size: 1.7rem;
      color: var(--gold);
      margin-bottom: 0.4rem;
      text-shadow: 0 2px 15px rgba(0, 0, 0, 0.85);
    }

    .hero-headline {
      font-size: clamp(2.5rem, 5.2vw, 4.4rem);
      font-weight: 300;
      letter-spacing: 0.02em;
      color: #fff;
      text-shadow: 0 10px 35px rgba(0, 0, 0, 0.85);
      margin-bottom: 1rem;
    }

    .hero-headline strong {
      font-weight: 700;
    }

    .hero-desc {
      max-width: 650px;
      font-size: 1rem;
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.84);
      margin-bottom: 2.2rem;
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.85);
    }

    .hero-cta-group {
      display: flex;
      gap: 1.1rem;
      align-items: center;
    }

    .btn-primary-gold {
      background: var(--gold);
      color: #050811;
      border: none;
      padding: 0.9rem 2.2rem;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 0 25px var(--gold-glow);
      transition: all var(--transition-fast);
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .btn-primary-gold:hover {
      transform: translateY(-2px);
      background: #ffd65a;
      box-shadow: 0 0 35px rgba(245, 197, 66, 0.65);
    }

    .btn-secondary-glass {
      background: rgba(12, 18, 32, 0.55);
      backdrop-filter: blur(12px);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.25);
      padding: 0.9rem 1.7rem;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.78rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all var(--transition-fast);
    }

    .btn-secondary-glass:hover {
      background: rgba(255, 255, 255, 0.14);
      border-color: #fff;
    }

    /* Peek Card on Right Edge */
    .hero-peek-card {
      position: fixed;
      right: -195px;
      top: 50%;
      transform: translateY(-55%);
      width: 260px;
      height: 340px;
      border-radius: 3px;
      background: var(--glass-bg);
      backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      cursor: pointer;
      z-index: 15;
      opacity: 0;
      pointer-events: none;
      transition: all var(--transition-slow);
      box-shadow: -15px 20px 45px rgba(0, 0, 0, 0.75);
    }

    .stage.hero-active .hero-peek-card {
      right: -140px;
      opacity: 0.9;
      pointer-events: auto;
    }

    .stage.hero-active .hero-peek-card:hover {
      right: -115px;
      opacity: 1;
      border-color: var(--gold);
    }

    /* ================= BOTTOM HUD ================= */
    .bottom-hud {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 1.5rem 4rem 2.2rem;
      z-index: 20;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
      pointer-events: none;
      transition: opacity 0.5s ease, transform 0.5s ease;
    }

    .bottom-hud.hidden-for-reading {
      opacity: 0;
      pointer-events: none;
      transform: translateY(25px);
    }

    .pager-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      pointer-events: auto;
    }

    .pager-num {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.78rem;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.55);
      cursor: pointer;
      transition: all var(--transition-fast);
      background: transparent;
      border: 1px solid transparent;
    }

    .pager-num:hover {
      color: #fff;
      border-color: rgba(255, 255, 255, 0.25);
    }

    .pager-num.active {
      background: var(--gold);
      color: #050811;
      box-shadow: 0 0 15px var(--gold-glow);
      transform: scale(1.1);
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: 220px 220px 240px 1fr;
      align-items: end;
      gap: 2.5rem;
      pointer-events: auto;
    }

    .metric-block {
      display: flex;
      flex-direction: column;
      gap: 0.28rem;
    }

    .metric-svg {
      width: 125px;
      height: 46px;
      stroke: rgba(255, 255, 255, 0.85);
      stroke-width: 1.8;
      fill: none;
      margin-bottom: 0.2rem;
    }

    .metric-svg path {
      stroke-dasharray: 300;
      stroke-dashoffset: 0;
      animation: drawLine 1.2s ease forwards;
    }

    @keyframes drawLine {
      from { stroke-dashoffset: 300; }
      to { stroke-dashoffset: 0; }
    }

    .metric-val {
      font-family: 'Oswald', sans-serif;
      font-size: 1.75rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      color: #fff;
      line-height: 1;
    }

    .metric-val sup {
      font-size: 0.72rem;
      color: var(--gold);
      margin-left: 3px;
      font-weight: 600;
    }

    .metric-label {
      font-size: 0.64rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .metric-sub {
      font-size: 0.6rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(245, 197, 66, 0.85);
    }

    .globe-block {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .globe-circle {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background-size: cover;
      background-position: center;
      border: 2px solid rgba(245, 197, 66, 0.6);
      position: relative;
      flex-shrink: 0;
    }

    .globe-circle::after {
      content: "";
      position: absolute;
      inset: 4px;
      border-radius: 50%;
      border: 1px dashed rgba(255, 255, 255, 0.45);
    }

    .coords-text {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .coords-val {
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      color: #fff;
      font-weight: 600;
    }

    .hud-right {
      justify-self: end;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.55rem;
    }

    .maqdisi-badge-btn {
      background: rgba(245, 197, 66, 0.12);
      border: 1px solid rgba(245, 197, 66, 0.45);
      color: var(--gold);
      padding: 0.55rem 1.2rem;
      border-radius: 99px;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all var(--transition-fast);
    }

    .maqdisi-badge-btn:hover {
      background: var(--gold);
      color: #050811;
    }

    .dots-indicator {
      display: flex;
      gap: 0.45rem;
      align-items: center;
    }

    .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transition: all var(--transition-fast);
    }

    .dot.active {
      width: 18px;
      border-radius: 99px;
      background: var(--gold);
    }

    /* ================= CINEMATIC EDITORIAL READING VIEW ================= */
    /* Sama atmosfernya dengan halaman utama: transparan, lapang, tanpa box padat */
    .reading-overlay {
      position: fixed;
      inset: 0;
      z-index: 45;
      overflow-y: auto;
      overflow-x: hidden;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1);
      scroll-behavior: smooth;
    }

    .reading-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }

    /* Custom subtle scrollbar */
    .reading-overlay::-webkit-scrollbar {
      width: 6px;
    }
    .reading-overlay::-webkit-scrollbar-track {
      background: transparent;
    }
    .reading-overlay::-webkit-scrollbar-thumb {
      background: rgba(245, 197, 66, 0.3);
      border-radius: 99px;
    }

    /* Top Sticky Chapter Bar (Floating Glass Pill) */
    .chapter-nav-sticky {
      position: sticky;
      top: 5.8rem;
      z-index: 50;
      display: flex;
      justify-content: center;
      padding: 0 2rem;
      pointer-events: none;
    }

    .chapter-pill-bar {
      pointer-events: auto;
      background: rgba(8, 12, 22, 0.68);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 999px;
      padding: 0.38rem;
      display: flex;
      gap: 0.35rem;
      flex-wrap: wrap;
      justify-content: center;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    }

    .chapter-pill-btn {
      background: transparent;
      border: none;
      color: rgba(255, 255, 255, 0.62);
      padding: 0.55rem 1.25rem;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all var(--transition-fast);
    }

    .chapter-pill-btn:hover {
      color: #fff;
    }

    .chapter-pill-btn.active {
      background: var(--gold);
      color: #050811;
      font-weight: 700;
      box-shadow: 0 0 18px var(--gold-glow);
    }

    /* Editorial Container */
    .editorial-container {
      max-width: 860px;
      margin: 0 auto;
      padding: 9rem 2rem 8rem;
    }

    /* Chapter Hero Header */
    .chapter-hero {
      text-align: center;
      margin-bottom: 5rem;
      padding-bottom: 3.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .chapter-kicker {
      font-size: 0.72rem;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: var(--gold);
      font-weight: 700;
      margin-bottom: 1rem;
      display: block;
    }

    .chapter-main-title {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(2.4rem, 4.8vw, 3.8rem);
      line-height: 1.08;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #fff;
      margin-bottom: 2.2rem;
    }

    .chapter-arabic-banner {
      margin: 2.2rem auto 0;
      max-width: 720px;
      padding: 1.8rem 2rem;
      border-top: 1px solid rgba(245, 197, 66, 0.3);
      border-bottom: 1px solid rgba(245, 197, 66, 0.3);
      background: linear-gradient(90deg, transparent, rgba(245, 197, 66, 0.06), transparent);
    }

    .chapter-arabic-text {
      font-family: 'Amiri', serif;
      font-size: 1.85rem;
      line-height: 1.85;
      color: #fde68a;
      margin-bottom: 0.7rem;
      direction: rtl;
    }

    .chapter-quote-meaning {
      font-size: 0.95rem;
      font-style: italic;
      color: rgba(255, 255, 255, 0.8);
      line-height: 1.65;
    }

    /* Editorial Sections (Airy, Long-form, Timeless) */
    .editorial-section {
      margin-bottom: 4.8rem;
    }

    .section-index-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.1rem;
    }

    .section-num {
      font-family: 'Oswald', sans-serif;
      font-size: 0.85rem;
      letter-spacing: 0.2em;
      color: var(--gold);
      font-weight: 600;
    }

    .section-line {
      height: 1px;
      flex: 1;
      background: linear-gradient(90deg, rgba(245, 197, 66, 0.45), transparent);
    }

    .section-title {
      font-family: 'Oswald', sans-serif;
      font-size: 1.85rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: #fff;
      margin-bottom: 1.4rem;
      line-height: 1.2;
    }

    .editorial-prose p {
      font-size: 1.06rem;
      line-height: 1.92;
      color: var(--text-body);
      margin-bottom: 1.45rem;
      font-weight: 400;
    }

    .editorial-prose strong {
      color: #fff;
      font-weight: 600;
    }

    .editorial-prose em {
